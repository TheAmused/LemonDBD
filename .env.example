# ==============================================================================
# LemonDBD - Unified Environment Configuration (Single Source of Truth)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Backend Server & Runtime Configuration
# ------------------------------------------------------------------------------
FLASK_RUN_HOST=0.0.0.0
FLASK_RUN_PORT=5000
FLASK_DEBUG=false
FLASK_ENV=production

# ------------------------------------------------------------------------------
# 2. Security, Authentication & Session Tokens
# ------------------------------------------------------------------------------
SECRET_KEY=change-this-in-production-to-a-secure-random-string
JWT_SECRET_KEY=change-this-in-production-to-a-secure-random-string
JWT_EXPIRATION_HOURS=24
CORS_ORIGINS=*

# ------------------------------------------------------------------------------
# 2b. Outgoing Mail (email verification & password reset)
# ------------------------------------------------------------------------------
# Gmail SMTP works out of the box for free - generate an "app password" at
# https://myaccount.google.com/apppasswords (not your regular Gmail password).
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=
# Base URL of the frontend, used to build verification/reset links in emails.
FRONTEND_URL=https://localhost

# ------------------------------------------------------------------------------
# 3. PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=dbd_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/dbd_db

# ------------------------------------------------------------------------------
# 4. Background Scraper & Pipeline Settings
# ------------------------------------------------------------------------------
INITIAL_SCRAPE_ENABLED=true

# ------------------------------------------------------------------------------
# 5. Discord Webhooks & Bug Reports
# ------------------------------------------------------------------------------
DISCORD_WEBHOOK_URL=

# ------------------------------------------------------------------------------
# 6. Frontend Settings & Donation Links
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=https://localhost
NEXT_PUBLIC_BUY_ME_A_COFFEE_URL=https://buymeacoffee.com/YOUR_USERNAME
NEXT_PUBLIC_KOFI_URL=https://ko-fi.com/YOUR_USERNAME
NEXT_PUBLIC_PATREON_URL=https://patreon.com/YOUR_USERNAME
NEXT_PUBLIC_DONATION_MESSAGE="Fuel the Entity with caffeine to keep LemonDBD servers running 24/7!"

# ------------------------------------------------------------------------------
# 7. Umami Analytics (self-hosted, its own port -- see UMAMI_PORT)
# ------------------------------------------------------------------------------
# Generate a real secret for production, e.g.: openssl rand -hex 32
UMAMI_APP_SECRET=change-this-to-a-random-secret-in-production
# Host port nginx publishes the Umami dashboard on.
UMAMI_PORT=8117
# Public URL for the dashboard/tracking script, e.g. https://localhost:8117
# or https://your-domain:8117. Leave blank to disable tracking entirely.
NEXT_PUBLIC_UMAMI_URL=https://localhost:8117
# After first login and creating a website in Umami, paste its Website ID here.
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# ------------------------------------------------------------------------------
# 8. pgAdmin 4 (Web PostgreSQL Management Dashboard, like phpMyAdmin for MySQL)
# ------------------------------------------------------------------------------
PGADMIN_PORT=5050
PGADMIN_DEFAULT_EMAIL=admin@lemondbd.local
PGADMIN_DEFAULT_PASSWORD=admin
NEXT_PUBLIC_PGADMIN_URL=https://localhost:5050
