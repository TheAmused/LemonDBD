# PostgreSQL Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=dbd_db
POSTGRES_PORT=5432

# SQLAlchemy Database Connection URI (using Psycopg 3 driver)
DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/dbd_db

# Flask Application Settings
FLASK_ENV=production
SECRET_KEY=change-this-in-production-to-a-secure-random-string
CORS_ORIGINS=*
NEXT_PUBLIC_API_URL=https://localhost


FLASK_DEBUG=0

# Discord Webhook for Bug Reports & Glitch Transmissions
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_NEW_WEBHOOK_HERE

# ==========================================
# 2. Buy Me a Coffee / Donation Links (Frontend)
# ==========================================
NEXT_PUBLIC_BUY_ME_A_COFFEE_URL=https://buymeacoffee.com/YOUR_USERNAME
NEXT_PUBLIC_KOFI_URL=https://ko-fi.com/YOUR_USERNAME
NEXT_PUBLIC_PATREON_URL=https://patreon.com/YOUR_USERNAME

# Optional Custom Message
NEXT_PUBLIC_DONATION_MESSAGE="Fuel the Entity with caffeine to keep LemonDBD servers running 24/7!"