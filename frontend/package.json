{
  "name": "LemonDBD",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit -p .",
    "lint": "oxlint --format=stylish",
    "check:lint-suppressions": "tsx scripts/check-lint-suppressions.ts",
    "prebuild": "npm run lint",
    "test": "npm run test:unit && npm run test:guards",
    "test:unit": "tsx --test \"src/__tests__/unit/**/*.test.ts\" \"src/__tests__/unit/**/*.test.tsx\"",
    "test:changed": "tsx scripts/test-affected.ts",
    "test:e2e": "tsx scripts/run-e2e.ts --test-concurrency=1 \"e2e/*.e2e.ts\"",
    "test:minigames:e2e": "node scripts/verify-minigames.mjs",
    "check:i18n": "tsx scripts/check-hardcoded-strings.ts",
    "check:i18n:strict": "tsx scripts/check-hardcoded-strings.ts --strict",
    "check:styles": "tsx scripts/check-global-styles.ts",
    "check:styles:strict": "tsx scripts/check-global-styles.ts --strict",
    "check:built": "tsx scripts/check-built-output.ts",
    "check:rendered": "tsx scripts/check-rendered.ts",
    "postbuild": "npm run check:built",
    "test:guards": "tsx --test \"src/__tests__/guards/*.test.ts\"",
    "check": "npm run test:guards",
    "check:typography": "tsx scripts/check-typography.ts",
    "screenshots": "node scripts/site-tour.mjs",
    "screenshots:update": "node scripts/site-tour.mjs --update",
    "screenshots:quick": "node scripts/site-tour.mjs --viewports=desktop,mobile"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "framer-motion": "^13.1.1",
    "lucide-react": "^1.33.0",
    "next": "^16.4.2",
    "next-themes": "^0.4.6",
    "react": "^19.2.9",
    "react-colorful": "^5.6.1",
    "react-dom": "^19.2.9",
    "tailwind-merge": "^3.6.0",
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.14.6",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "happy-dom": "^20.14.6",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2004",
    "playwright": "^1.62.1",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "ts-morph": "^28.0.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "postcss": "^8.5.26",
    "sharp": "^0.35.4"
  },
  "allowScripts": {
    "esbuild": true
  }
}
