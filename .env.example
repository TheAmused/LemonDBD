# ==============================================================================
# LemonDBD - Unified Environment Configuration (Single Source of Truth)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Backend Server & Runtime Configuration
# ------------------------------------------------------------------------------
FLASK_RUN_HOST=0.0.0.0
FLASK_RUN_PORT=5000
FLASK_DEBUG=false
FLASK_ENV=production

# ------------------------------------------------------------------------------
# 2. Security, Authentication & Session Tokens
# ------------------------------------------------------------------------------
SECRET_KEY=change-this-in-production-to-a-secure-random-string
JWT_SECRET_KEY=change-this-in-production-to-a-secure-random-string
JWT_EXPIRATION_HOURS=24
CORS_ORIGINS=*

# ------------------------------------------------------------------------------
# 3. PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=dbd_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/dbd_db

# ------------------------------------------------------------------------------
# 4. Background Scraper & Pipeline Settings
# ------------------------------------------------------------------------------
INITIAL_SCRAPE_ENABLED=true

# ------------------------------------------------------------------------------
# 5. Discord Webhooks & Bug Reports
# ------------------------------------------------------------------------------
DISCORD_WEBHOOK_URL=

# ------------------------------------------------------------------------------
# 6. Frontend Settings & Donation Links
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=https://localhost
NEXT_PUBLIC_BUY_ME_A_COFFEE_URL=https://buymeacoffee.com/YOUR_USERNAME
NEXT_PUBLIC_KOFI_URL=https://ko-fi.com/YOUR_USERNAME
NEXT_PUBLIC_PATREON_URL=https://patreon.com/YOUR_USERNAME
NEXT_PUBLIC_DONATION_MESSAGE="Fuel the Entity with caffeine to keep LemonDBD servers running 24/7!"
