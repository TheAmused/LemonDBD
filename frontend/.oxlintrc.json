{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "react",
    "nextjs",
    "jsx-a11y",
    "import",
    "unicorn",
    "oxc"
  ],
  "categories": {
    "correctness": "error"
  },
  "options": {
    "denyWarnings": true,
    "typeAware": true,
    "reportUnusedDisableDirectives": "error"
  },
  "settings": {
    "next": {
      "rootDir": [
        "."
      ]
    },
    "react": {
      "version": "19.0"
    }
  },
  "env": {
    "browser": true,
    "node": true,
    "es2024": true
  },
  "ignorePatterns": [
    ".next/**",
    "out/**",
    "node_modules/**",
    "public/**",
    "next-env.d.ts",
    "coverage/**",
    "src/__tests__/**",
    "e2e/**"
  ],
  "rules": {
    // --- React & React 19 / Compiler Core ---
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "error",
    "react/rule-suppression": "error",
    "react/set-state-in-effect": "error",
    "react/refs": "error",
    "react/purity": "error",
    "react/immutability": "error",
    "react/preserve-manual-memoization": "error",
    "react/jsx-no-target-blank": "error",
    "react/jsx-key": "error",
    "react/void-dom-elements-no-children": "error",
    // --- Next.js Architecture & Optimization ---
    "nextjs/no-async-client-component": "error",
    "nextjs/no-html-link-for-pages": "error",
    "nextjs/no-img-element": "error",
    "nextjs/inline-script-id": "error",
    "nextjs/no-sync-scripts": "error",
    "nextjs/next-script-for-ga": "error",
    "nextjs/no-unwanted-polyfillio": "error",
    "nextjs/no-assign-module-variable": "error",
    "nextjs/no-head-element": "error",
    "nextjs/no-head-import-in-document": "error",
    "nextjs/no-document-import-in-page": "error",
    "nextjs/no-duplicate-head": "error",
    "nextjs/no-before-interactive-script-outside-document": "error",
    "nextjs/no-css-tags": "error",
    "nextjs/no-page-custom-font": "error",
    "nextjs/google-font-display": "error",
    "nextjs/google-font-preconnect": "error",
    "nextjs/no-typos": "error",
    // --- Strict TypeScript & Boundary Rules ---
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "typescript/await-thenable": "error",
    "typescript/consistent-type-imports": [
      "error",
      {
        "prefer": "type-imports",
        "fixStyle": "separate-type-imports"
      }
    ],
    "typescript/no-explicit-any": "error",
    "typescript/no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "caughtErrorsIgnorePattern": "^_"
      }
    ],
    // --- Imports & Modularity ---
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": [
              "@/features/*/*"
            ],
            "message": "Deep imports into feature internals are forbidden. Import from the feature barrel (@/features/<name>) instead."
          }
        ]
      }
    ],
    "import/no-cycle": "error",
    "import/no-self-import": "error",
    "import/no-duplicates": "error",
    // --- Accessibility (jsx-a11y) ---
    "jsx-a11y/alt-text": "error",
    "jsx-a11y/aria-props": "error",
    "jsx-a11y/aria-proptypes": "error",
    "jsx-a11y/aria-role": "error",
    "jsx-a11y/aria-unsupported-elements": "error",
    "jsx-a11y/click-events-have-key-events": "error",
    "jsx-a11y/control-has-associated-label": "error",
    "jsx-a11y/heading-has-content": "error",
    "jsx-a11y/html-has-lang": "error",
    "jsx-a11y/media-has-caption": "error",
    "jsx-a11y/no-aria-hidden-on-focusable": "error",
    "jsx-a11y/no-autofocus": "error",
    "jsx-a11y/no-noninteractive-element-interactions": "error",
    "jsx-a11y/no-noninteractive-element-to-interactive-role": "error",
    "jsx-a11y/no-static-element-interactions": "error",
    "jsx-a11y/prefer-tag-over-role": "error",
    "jsx-a11y/role-has-required-aria-props": "error",
    // --- Modern ECMAScript / Cleanliness ---
    "no-useless-escape": "error",
    "unicorn/prefer-node-protocol": "error"
  },
  "overrides": [
    {
      // Custom widgets with no native tag: a contentEditable textbox and a combobox with a rich,
      // thumbnail-and-badge listbox. Their ARIA roles are the accessible markup, so the rule
      // cannot apply. Every other exception is rejected by scripts/check-lint-suppressions.ts.
      "files": [
        "src/components/minigames/CharacterAutocomplete.tsx",
        "src/components/common/RichTextEditor.tsx"
      ],
      "rules": {
        "jsx-a11y/prefer-tag-over-role": "off"
      }
    },
    {
      "files": [
        "src/components/common/Img.tsx"
      ],
      "rules": {
        "nextjs/no-img-element": "off"
      }
    }
  ]
}