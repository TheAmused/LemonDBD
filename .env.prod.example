# ==============================================================================
# LemonDBD - PRODUCTION environment template
# ==============================================================================
# Copy to .env.prod (chmod 600), fill in every REQUIRED value, and point .env at it:
#   ENV_FILE=.env.prod
#   COMPOSE_TARGET=docker-compose.prod.yml
# Never commit the filled-in copy. The backend refuses to start with an empty or publicly
# known SECRET_KEY / JWT_SECRET_KEY / TWO_FACTOR_ENCRYPTION_KEY or with CORS_ORIGINS=*, and
# compose refuses to start without the database, Umami and pgAdmin passwords.
# Generate secrets with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Same keys as .env.example (which documents each one); only the values differ.
# ==============================================================================

# ------------------------------------------------------------------------------
# 0. Active Environment Selector (used in .env)
# ------------------------------------------------------------------------------
ENV_FILE=.env.prod
COMPOSE_TARGET=docker-compose.prod.yml
COMPOSE_FILE=docker-compose.prod.yml
COMPOSE_ENV_FILES=.env.prod

# ------------------------------------------------------------------------------
# 1. Feature Toggles
# ------------------------------------------------------------------------------
# true = sign-up/sign-in/password reset/guest bug reports need a solved ALTCHA challenge (keep true in production)
RATELIMIT_ENABLED=true
ALTCHA_ENFORCED=true
# the dedicated scheduler container runs the jobs; keep the web workers out of it
SCHEDULER_ENABLED=false

# ------------------------------------------------------------------------------
# 2. Backend Server & Runtime Configuration
# ------------------------------------------------------------------------------
FLASK_RUN_HOST=0.0.0.0
FLASK_RUN_PORT=5000
# FLASK_ENV=development is the ONLY value that enables the demo accounts (lemon/user),
FLASK_DEBUG=false
# the "quick demo" buttons in the login modal and their data seeding.
# Anything else (production, staging, unset) disables them completely.
# Admin-created tier lists and smash rosters are also written back into
FLASK_ENV=production
# backend/app/seeds/data/... so a reseed keeps them. On by default only with
# FLASK_ENV=development (a checkout you commit); in production the database is the
# record -- use the admin database export. Set true/false to override.
# SEED_WRITEBACK=
# Largest request body the backend accepts (bytes); matches nginx client_max_body_size.
# MAX_CONTENT_LENGTH=20971520

# ------------------------------------------------------------------------------
# 3. Security, Authentication & Session Tokens
# ------------------------------------------------------------------------------
# These two sign every login session. The values below are for local development ONLY:
# outside FLASK_ENV=development the backend refuses to start with them (and warns when a key is
# shorter than 32 characters). Generate real ones with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# REQUIRED: long random value
SECRET_KEY=
# REQUIRED: long random value, different from SECRET_KEY
JWT_SECRET_KEY=
# Secure flag on the session cookie: auto (when the request arrived over HTTPS), true or false.
JWT_EXPIRATION_HOURS=24
# Use true in production so the cookie is never sent over plain HTTP.
# Optional two-factor sign-in (authenticator app). Users switch it on themselves from their
SESSION_COOKIE_SECURE=true
# profile page; this key encrypts their TOTP secrets in the database. Leave it empty and the
# feature is simply unavailable (FLASK_ENV=development falls back to a public dev key, which
# production refuses to start with). Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# KEEP IT SECRET in production (never commit a production key; restrict .env.prod permissions to 0600)
# and back it up -- if it is lost every enrolled user needs a 2FA reset (admin panel, or
# `python scripts/reset_two_factor.py <user>` on the server).
# To rotate: put the new key FIRST and keep the old one, comma separated: NEW_KEY,OLD_KEY
# fresh Fernet key, or empty to switch two-factor sign-in off
TWO_FACTOR_ENCRYPTION_KEY=
# Name shown next to the account inside the authenticator app.
# Ban-evasion e-mail list: a permanent ban stores an HMAC-SHA256 hash of the account's canonical
TWO_FACTOR_ISSUER=LemonDBD
# e-mail so the same person cannot register again. Leave BAN_LIST_ENABLED=false until the Privacy
# Policy that describes it is live (while off nothing is hashed, stored or checked).
# Pepper: a SEPARATE random secret (not SECRET_KEY), 32+ bytes of hex, newest first, comma separated:
#   python -c "import secrets; print('v1:' + secrets.token_hex(32))"
# To rotate: add "v2:<new>" in front and keep v1 (lookups try every version); never log or commit it.
# If it is lost the stored hashes can no longer be matched. Back it up like TWO_FACTOR_ENCRYPTION_KEY.
BAN_LIST_ENABLED=false
# Exact origins (comma separated, scheme + host + port) allowed to call the API with cookies.
BAN_LIST_PEPPERS=
# Leave empty to allow only FRONTEND_URL. `*` is refused at startup outside development.
# empty = only FRONTEND_URL
CORS_ORIGINS=

# ------------------------------------------------------------------------------
# 4. Outgoing Mail (email verification & password reset)
# ------------------------------------------------------------------------------
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
# Shown on the Privacy Policy page (defaults to MAIL_USERNAME when empty)
MAIL_DEFAULT_SENDER=
PRIVACY_CONTACT_EMAIL=
# Google sign-in. OAuth "Web application" client id from Google Cloud Console (Credentials), with
REQUIRE_EMAIL_VERIFICATION=true
# your site origin(s) under "Authorized JavaScript origins". Leave empty to hide the Google buttons.
GOOGLE_CLIENT_ID=
# ------------------------------------------------------------------------------
FRONTEND_URL=https://your-domain.example
# 5. PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
# Required (compose refuses to start without it). Generate one with:
POSTGRES_USER=postgres
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
# REQUIRED
POSTGRES_PASSWORD=
POSTGRES_DB=dbd_db
# Interface the database port is published on. Loopback keeps it off the network.
POSTGRES_PORT=5432
# Leave empty to build it from POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB.
POSTGRES_BIND=127.0.0.1
# Dev overlay only: gunicorn is published on 127.0.0.1:${BACKEND_PORT} for debugging.
DATABASE_URL=
# Production never publishes it; everything goes through nginx.
# ------------------------------------------------------------------------------
BACKEND_PORT=5000
# 6. Discord Webhooks & Cloudflare Tunnel
# ------------------------------------------------------------------------------
# Channel where published "What's New" entries are announced (the send button next to each entry in the What's New modal). Empty = off.
DISCORD_WEBHOOK_URL=
DISCORD_CHANGELOG_WEBHOOK_URL=
DISCORD_TUNNEL_WEBHOOK=
# ------------------------------------------------------------------------------
DISCORD_TUNNEL_WEBHOOK_ENABLED=false
# 7. Frontend Settings & Donation Links
# ------------------------------------------------------------------------------
# Public origin of the site (no trailing slash). Enables canonical + hreflang tags; leave empty to omit them.
NEXT_PUBLIC_SITE_URL=https://your-domain.example
# Starting values of the public links; the admin Settings tab overrides each without a redeploy.
NEXT_PUBLIC_API_URL=https://your-domain.example
DISCORD_INVITE_URL=https://discord.gg/Veygfp6XfT
DONATION_BMC_URL=https://buymeacoffee.com/lemondbd
DONATION_KOFI_URL=https://ko-fi.com/lemondbd
# ------------------------------------------------------------------------------
DONATION_PATREON_URL=https://patreon.com/lemondbd
# 8. Umami Analytics
# ------------------------------------------------------------------------------
# Required. Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
# REQUIRED
UMAMI_APP_SECRET=
# Only the tracker (/script.js, /api/send) is public on this port; the dashboard answers
UMAMI_PORT=8117
# loopback / private-network clients only (use an SSH tunnel from elsewhere).
NEXT_PUBLIC_UMAMI_URL=https://your-domain.example:8117
# Required. Umami starts with admin/umami: change that password in the Umami dashboard,
UMAMI_ADMIN_USERNAME=admin
# then put the new one here (the site uses it to provision its website ID).
# REQUIRED (after changing it in Umami)
UMAMI_ADMIN_PASSWORD=
UMAMI_SITE_NAME=LemonDBD
# ------------------------------------------------------------------------------
UMAMI_SITE_DOMAIN=your-domain.example
# 9. pgAdmin 4
# ------------------------------------------------------------------------------
# Interface the pgAdmin port is published on. Keep 127.0.0.1 in production and use an SSH tunnel
PGADMIN_PORT=5050
# (ssh -L 5050:127.0.0.1:5050 <host>); 0.0.0.0 exposes the database console to the network.
# pgAdmin runs in server mode: these are its login. Use a strong password outside local development.
PGADMIN_BIND=127.0.0.1
# Required.
PGADMIN_DEFAULT_EMAIL=admin@lemondbd.com
# REQUIRED
PGADMIN_DEFAULT_PASSWORD=
# reached through an SSH tunnel
NEXT_PUBLIC_PGADMIN_URL=https://localhost:5050

# ------------------------------------------------------------------------------
# 10. Tuning (optional -- the values shown are the defaults)
# ------------------------------------------------------------------------------
# Database connection pool per gunicorn worker.
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=5
# DB_POOL_RECYCLE=300
# DB_POOL_TIMEOUT=30
# gunicorn (backend/gunicorn.conf.py).
# GUNICORN_WORKERS=4
# GUNICORN_THREADS=8
# GUNICORN_TIMEOUT=60
# GUNICORN_LOGLEVEL=info
# Admin database imports may be this large (MB); nginx allows the same on that path.
# DATABASE_IMPORT_MAX_MB=512
# Shared catalog cache and the never-evicting store for rate limits / ALTCHA records.
# REDIS_URL=redis://redis:6379/0
# LIMITS_REDIS_URL=redis://redis-limits:6379/0
# REDIS_MAXMEMORY=256mb
# REDIS_LIMITS_MAXMEMORY=32mb
# CATALOG_CACHE_TTL=86400
# Limit applied to every API route without its own.
# RATELIMIT_DEFAULT=200 per minute
# Days without activity before an open streak run counts as lost (the admin Settings tab overrides it).
# STREAK_INACTIVITY_PRUNE_DAYS=90

# ------------------------------------------------------------------------------
# 11. Set by docker-compose / the images (listed for completeness; normally left alone)
# ------------------------------------------------------------------------------
# INTERNAL_API_URL=http://backend:5000      frontend server -> backend, inside the docker network
# UMAMI_INTERNAL_URL=http://umami:3000      frontend server -> Umami, inside the docker network
# UMAMI_PUBLIC_URL=                         copied from NEXT_PUBLIC_UMAMI_URL
# TUNNEL_TARGET_URL=http://nginx:80         dev tunnel target
# TUNNEL_HOST_HEADER=                       dev tunnel Host header override
# GUNICORN_BIND=0.0.0.0:5000
# GUNICORN_WORKER_CLASS=gthread
# GUNICORN_WORKER_TMP_DIR=/dev/shm
# GUNICORN_KEEPALIVE=5
# GUNICORN_PRELOAD=true
# GUNICORN_MAX_REQUESTS=1000
# GUNICORN_MAX_REQUESTS_JITTER=100
# FLASK_APP=run.py
# HOST=0.0.0.0                              older alias of FLASK_RUN_HOST
# PORT=5000                                 older alias of FLASK_RUN_PORT
# JWT_ALGORITHM=HS256
# RATELIMIT_STORAGE_URI=                    empty: LIMITS_REDIS_URL / REDIS_URL, else per-worker memory
# RATELIMIT_STRATEGY=fixed-window
# SITE_SETTINGS_CACHE_SECONDS=5             admin settings cache per process
# SANCTION_EMAIL_ASYNC=true                 send moderation e-mails in a background thread
# SEED_UPDATES_DIR=/app/updates             where the seeder looks for update files
# DISCORD_TUNNEL_NOTIFY_ENABLED=false       older name of DISCORD_TUNNEL_WEBHOOK_ENABLED
# TUNNEL_WEBHOOK_ENABLED=false              older name of DISCORD_TUNNEL_WEBHOOK_ENABLED
